<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Onera Stock</title>
    <!-- Tailwind CSS for UI -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- HTML5 QRCode Scanner Library -->
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
        }
        #reader {
            width: 100%;
            border-radius: 0.75rem;
            overflow: hidden;
            background: #000;
        }
        #reader video {
            object-fit: cover;
            border-radius: 0.75rem;
        }
        .pulse-nfc {
            animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @keyframes pulse-ring {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.7; transform: scale(1.03); }
        }
    </style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 flex flex-col font-sans antialiased">

    <!-- Header -->
    <header class="bg-indigo-600 text-white shadow-lg sticky top-0 z-40">
        <div class="max-w-md mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <i class="fa-solid fa-boxes-stacked text-2xl"></i>
                <h1 class="text-xl font-bold tracking-wide">Onera Stock</h1>
            </div>
            <button id="btn-open-guide" class="text-xs bg-indigo-500 hover:bg-indigo-700 px-3 py-1.5 rounded-full border border-indigo-300 transition-colors flex items-center gap-1 shadow-sm">
                <i class="fa-solid fa-circle-question"></i>
                <span>Setup Guide</span>
            </button>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-md mx-auto w-full flex-grow p-4 space-y-4 pb-20">

        <!-- API Endpoint Configuration Box -->
        <section class="bg-white rounded-xl shadow-md p-4 border border-slate-200">
            <div class="flex items-center justify-between mb-2">
                <label for="apps-script-url" class="text-xs font-bold text-slate-500 uppercase tracking-wider flex items-center gap-1">
                    <i class="fa-solid fa-link text-indigo-500"></i> Google Apps Script Endpoint
                </label>
                <span id="endpoint-status-badge" class="text-[10px] bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-semibold">Configured</span>
            </div>
            <div class="flex gap-2">
                <input type="url" id="apps-script-url" value="https://script.google.com/macros/s/AKfycbw3J_UTxuGUETX1_b8MLp3Vd99gRp2gT9KJkhp_8ziAp8KPRV6FAk3ESxs_a2eQ9ShAKA/exec" placeholder="https://script.google.com/macros/s/.../exec" 
                       class="w-full text-xs p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all">
                <button id="btn-save-endpoint" class="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 rounded-lg text-xs font-semibold shrink-0 transition-colors">
                    Save
                </button>
            </div>
            <p class="text-[11px] text-slate-400 mt-1.5">Pre-configured with your Google Apps Script endpoint.</p>
        </section>

        <!-- Hardware Scanners (Barcode & NFC) -->
        <section class="grid grid-cols-2 gap-3">
            <button id="btn-start-barcode" class="flex flex-col items-center justify-center p-4 bg-indigo-600 text-white rounded-xl shadow-md hover:bg-indigo-700 active:scale-95 transition-all">
                <i class="fa-solid fa-barcode text-3xl mb-2"></i>
                <span class="text-sm font-bold">Scan Barcode</span>
                <span class="text-[10px] opacity-80 mt-0.5">Camera Reader</span>
            </button>

            <button id="btn-start-nfc" class="flex flex-col items-center justify-center p-4 bg-emerald-600 text-white rounded-xl shadow-md hover:bg-emerald-700 active:scale-95 transition-all relative">
                <i class="fa-solid fa-nfc-symbol text-3xl mb-2"></i>
                <span class="text-sm font-bold">Read NFC Tag</span>
                <span class="text-[10px] opacity-80 mt-0.5">Tap Card / Chip</span>
            </button>
        </section>

        <!-- Barcode Scanner Modal View -->
        <div id="barcode-scanner-wrapper" class="hidden bg-white rounded-xl shadow-md p-4 border border-slate-200">
            <div class="flex justify-between items-center mb-3">
                <span class="text-sm font-bold text-slate-700 flex items-center gap-2">
                    <i class="fa-solid fa-camera text-indigo-600"></i> Scanning Barcode / QR
                </span>
                <button id="btn-close-barcode" class="text-slate-400 hover:text-slate-600 text-sm font-bold px-2 py-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div id="reader"></div>
            <p class="text-xs text-center text-slate-500 mt-2">Center the barcode inside the target square</p>
        </div>

        <!-- NFC Listening Indicator Banner -->
        <div id="nfc-banner" class="hidden bg-emerald-500 text-white p-4 rounded-xl shadow-lg pulse-nfc flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <i class="fa-solid fa-wifi text-2xl animate-pulse"></i>
                <div>
                    <h4 class="text-sm font-bold">NFC Scanner Active</h4>
                    <p class="text-xs text-emerald-100">Hold your device near an NFC tag...</p>
                </div>
            </div>
            <button id="btn-cancel-nfc" class="bg-emerald-700 text-xs px-3 py-1.5 rounded-lg font-medium hover:bg-emerald-800">
                Cancel
            </button>
        </div>

        <!-- Data Collection Form -->
        <form id="inventory-form" class="bg-white rounded-xl shadow-md p-5 border border-slate-200 space-y-4">
            
            <!-- Item ID Input -->
            <div>
                <label for="item-id" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">
                    Scanned Item / NFC Tag ID <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                    <input type="text" id="item-id" required placeholder="Scan tag or type code..." 
                           class="w-full text-sm p-3 pr-10 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all font-mono font-medium">
                    <button type="button" id="btn-clear-id" class="absolute right-3 top-3 text-slate-400 hover:text-slate-600 hidden">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </button>
                </div>
            </div>

            <!-- Storage Location Dropdown -->
            <div>
                <label for="storage-location" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">
                    Storage Location <span class="text-red-500">*</span>
                </label>
                <select id="storage-location" required class="w-full text-sm p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all bg-white">
                    <option value="" disabled selected>Select location...</option>
                    <option value="Warehouse A - Bin 101">Warehouse A - Bin 101</option>
                    <option value="Warehouse A - Shelf 02">Warehouse A - Shelf 02</option>
                    <option value="Warehouse B - Main Rack">Warehouse B - Main Rack</option>
                    <option value="Cold Storage Unit C">Cold Storage Unit C</option>
                    <option value="In Transit / Loading Bay">In Transit / Loading Bay</option>
                    <option value="Dispatch Area">Dispatch Area</option>
                </select>
            </div>

            <!-- Operator Name Input -->
            <div>
                <label for="operator-name" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">
                    Operator Name / ID <span class="text-red-500">*</span>
                </label>
                <input type="text" id="operator-name" required placeholder="e.g. John Doe" 
                       class="w-full text-sm p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all">
            </div>

            <!-- Submit Button -->
            <button type="submit" id="btn-submit" class="w-full bg-slate-900 text-white font-bold py-3.5 px-4 rounded-lg shadow-lg hover:bg-slate-800 active:scale-[0.99] transition-all flex items-center justify-center space-x-2">
                <i class="fa-solid fa-paper-plane"></i>
                <span>Submit to Google Sheet</span>
            </button>
        </form>

        <!-- Feedback Alert Box -->
        <div id="status-alert" class="hidden rounded-xl p-4 text-sm font-medium border flex items-start gap-3 shadow-sm">
            <i id="alert-icon" class="fa-solid text-lg mt-0.5"></i>
            <div id="alert-message" class="flex-grow"></div>
        </div>

    </main>

    <!-- Setup & Instructions Modal -->
    <div id="guide-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl max-h-[90vh] flex flex-col overflow-hidden">
            <!-- Modal Header -->
            <div class="bg-indigo-600 text-white p-4 flex justify-between items-center shrink-0">
                <h3 class="font-bold text-lg flex items-center gap-2">
                    <i class="fa-solid fa-book-bookmark"></i> Onera Stock Hosting Guide
                </h3>
                <button id="btn-close-guide" class="text-white/80 hover:text-white text-xl">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            
            <!-- Modal Content Body -->
            <div class="p-5 overflow-y-auto space-y-6 text-sm text-slate-700">
                
                <!-- Section 1: GitHub Pages -->
                <div>
                    <h4 class="font-bold text-slate-900 text-base mb-2 flex items-center gap-2 border-b pb-1">
                        <i class="fa-brands fa-github text-lg text-indigo-600"></i> 1. Host Free on GitHub Pages
                    </h4>
                    <ol class="list-decimal list-inside space-y-1.5 text-xs text-slate-600 pl-1">
                        <li>Create a free account on <a href="https://github.com" target="_blank" class="text-indigo-600 underline">GitHub.com</a>.</li>
                        <li>Create a new repository named <code class="bg-slate-100 px-1 py-0.5 rounded text-indigo-700 font-mono">onera-stock</code>.</li>
                        <li>Upload this file as <code class="bg-slate-100 px-1 py-0.5 rounded text-indigo-700 font-mono">index.html</code> directly to the repository root.</li>
                        <li>Go to your repository <strong>Settings</strong> &gt; <strong>Pages</strong>.</li>
                        <li>Under <em>Branch</em>, select <strong>main</strong> (or master) and click <strong>Save</strong>.</li>
                        <li>In 1-2 minutes, GitHub will give you an HTTPS web link (e.g. <code class="text-emerald-700 font-mono">https://username.github.io/onera-stock/</code>) where camera & NFC work!</li>
                    </ol>
                </div>

                <!-- Section 2: Google Apps Script -->
                <div>
                    <h4 class="font-bold text-slate-900 text-base mb-2 flex items-center gap-2 border-b pb-1">
                        <i class="fa-solid fa-file-excel text-lg text-emerald-600"></i> 2. Connected Google Apps Script
                    </h4>
                    <p class="text-xs mb-2">Your app is configured with the following Google Apps Script endpoint:</p>
                    
                    <div class="relative bg-slate-900 text-slate-100 p-3 rounded-lg font-mono text-[11px] overflow-x-auto">
                        <pre><code>https://script.google.com/macros/s/AKfycbw3J_UTxuGUETX1_b8MLp3Vd99gRp2gT9KJkhp_8ziAp8KPRV6FAk3ESxs_a2eQ9ShAKA/exec</code></pre>
                    </div>
                </div>

                <!-- Section 3: NFC Compatibility -->
                <div class="bg-amber-50 p-3 rounded-xl border border-amber-200">
                    <h4 class="font-bold text-amber-900 text-xs flex items-center gap-1.5 mb-1">
                        <i class="fa-solid fa-triangle-exclamation text-amber-600"></i> NFC Compatibility Notice
                    </h4>
                    <p class="text-[11px] text-amber-800 leading-relaxed">
                        Web NFC is natively supported on <strong>Android devices running Google Chrome</strong> over HTTPS. Apple iOS restricts Web NFC in browser apps like Safari/Chrome; iOS users can scan barcodes using the camera or type Tag IDs manually.
                    </p>
                </div>

            </div>

            <!-- Modal Footer -->
            <div class="p-4 bg-slate-50 border-t flex justify-end">
                <button id="btn-dismiss-guide" class="bg-indigo-600 text-white text-xs font-bold px-4 py-2 rounded-lg hover:bg-indigo-700">
                    Got it!
                </button>
            </div>
        </div>
    </div>

    <script>
        // Default Apps Script Endpoint
        const DEFAULT_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbw3J_UTxuGUETX1_b8MLp3Vd99gRp2gT9KJkhp_8ziAp8KPRV6FAk3ESxs_a2eQ9ShAKA/exec';

        // State Management
        let html5QrCode = null;
        let nfcAbortController = null;

        // DOM Element Cache
        const appsScriptUrlInput = document.getElementById('apps-script-url');
        const btnSaveEndpoint = document.getElementById('btn-save-endpoint');
        const endpointStatusBadge = document.getElementById('endpoint-status-badge');
        
        const itemIdInput = document.getElementById('item-id');
        const btnClearId = document.getElementById('btn-clear-id');
        const storageLocationSelect = document.getElementById('storage-location');
        const operatorNameInput = document.getElementById('operator-name');
        
        const btnStartBarcode = document.getElementById('btn-start-barcode');
        const btnCloseBarcode = document.getElementById('btn-close-barcode');
        const barcodeScannerWrapper = document.getElementById('barcode-scanner-wrapper');
        
        const btnStartNfc = document.getElementById('btn-start-nfc');
        const btnCancelNfc = document.getElementById('btn-cancel-nfc');
        const nfcBanner = document.getElementById('nfc-banner');
        
        const inventoryForm = document.getElementById('inventory-form');
        const btnSubmit = document.getElementById('btn-submit');
        const statusAlert = document.getElementById('status-alert');
        const alertIcon = document.getElementById('alert-icon');
        const alertMessage = document.getElementById('alert-message');

        const guideModal = document.getElementById('guide-modal');
        const btnOpenGuide = document.getElementById('btn-open-guide');
        const btnCloseGuide = document.getElementById('btn-close-guide');
        const btnDismissGuide = document.getElementById('btn-dismiss-guide');

        // Load Saved Preferences on Startup
        window.addEventListener('DOMContentLoaded', () => {
            const savedUrl = localStorage.getItem('inventory_script_url');
            if (savedUrl) {
                appsScriptUrlInput.value = savedUrl;
            } else {
                appsScriptUrlInput.value = DEFAULT_SCRIPT_URL;
                localStorage.setItem('inventory_script_url', DEFAULT_SCRIPT_URL);
            }
            updateBadgeStatus('Configured', 'bg-emerald-100 text-emerald-800');

            const savedOperator = localStorage.getItem('inventory_operator_name');
            if (savedOperator) {
                operatorNameInput.value = savedOperator;
            }
        });

        // Save Endpoint URL
        btnSaveEndpoint.addEventListener('click', () => {
            const url = appsScriptUrlInput.value.trim();
            if (!url) {
                showAlert('Please enter a valid Apps Script URL', 'error');
                return;
            }
            localStorage.setItem('inventory_script_url', url);
            updateBadgeStatus('Saved', 'bg-emerald-100 text-emerald-800');
            showAlert('Google Apps Script URL saved successfully!', 'success');
        });

        function updateBadgeStatus(text, bgClasses) {
            endpointStatusBadge.textContent = text;
            endpointStatusBadge.className = `text-[10px] ${bgClasses} px-2 py-0.5 rounded-full font-semibold`;
        }

        // Camera Barcode Reader Logic
        btnStartBarcode.addEventListener('click', async () => {
            stopNfcScan(); // Stop NFC if active
            barcodeScannerWrapper.classList.remove('hidden');
            
            if (!html5QrCode) {
                html5QrCode = new Html5Qrcode("reader");
            }

            try {
                await html5QrCode.start(
                    { facingMode: "environment" },
                    { fps: 10, qrbox: { width: 250, height: 180 } },
                    (decodedText) => {
                        itemIdInput.value = decodedText;
                        toggleClearButton();
                        stopBarcodeScan();
                        showAlert(`Scanned Barcode: <strong>${decodedText}</strong>`, 'success');
                    },
                    (errorMessage) => {
                        // Scan errors are ignored per frame
                    }
                );
            } catch (err) {
                showAlert(`Camera access error: ${err.message || err}`, 'error');
                stopBarcodeScan();
            }
        });

        function stopBarcodeScan() {
            if (html5QrCode && html5QrCode.isScanning) {
                html5QrCode.stop().then(() => {
                    barcodeScannerWrapper.classList.add('hidden');
                }).catch(() => {
                    barcodeScannerWrapper.classList.add('hidden');
                });
            } else {
                barcodeScannerWrapper.classList.add('hidden');
            }
        }

        btnCloseBarcode.addEventListener('click', stopBarcodeScan);

        // Web NFC Tag Reading Logic
        btnStartNfc.addEventListener('click', async () => {
            stopBarcodeScan(); // Stop barcode if active

            if (!('NDEFReader' in window)) {
                showAlert('Web NFC is not supported on this browser/device. (Supported on Chrome for Android). You can still scan barcodes or type manually!', 'warning');
                return;
            }

            try {
                nfcAbortController = new AbortController();
                const ndef = new NDEFReader();

                await ndef.scan({ signal: nfcAbortController.signal });
                nfcBanner.classList.remove('hidden');

                ndef.addEventListener("reading", ({ serialNumber, message }) => {
                    let tagId = serialNumber;

                    // Try reading text records if serial number is missing
                    if (!tagId && message.records.length > 0) {
                        const decoder = new TextDecoder();
                        for (const record of message.records) {
                            if (record.recordType === "text") {
                                tagId = decoder.decode(record.data);
                                break;
                            }
                        }
                    }

                    tagId = tagId || "NFC-TAG-" + Math.floor(Math.random() * 1000000);

                    itemIdInput.value = tagId;
                    toggleClearButton();
                    stopNfcScan();
                    showAlert(`Scanned NFC Tag: <strong>${tagId}</strong>`, 'success');
                });

                ndef.addEventListener("readingerror", () => {
                    showAlert('Failed to read NFC tag. Try tapping again.', 'error');
                });

            } catch (err) {
                stopNfcScan();
                showAlert(`NFC Error: ${err.message || err}`, 'error');
            }
        });

        function stopNfcScan() {
            if (nfcAbortController) {
                nfcAbortController.abort();
                nfcAbortController = null;
            }
            nfcBanner.classList.add('hidden');
        }

        btnCancelNfc.addEventListener('click', stopNfcScan);

        // Clear ID Input
        itemIdInput.addEventListener('input', toggleClearButton);
        btnClearId.addEventListener('click', () => {
            itemIdInput.value = '';
            toggleClearButton();
        });

        function toggleClearButton() {
            if (itemIdInput.value) {
                btnClearId.classList.remove('hidden');
            } else {
                btnClearId.classList.add('hidden');
            }
        }

        // Form Submit Handler
        inventoryForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            const scriptUrl = appsScriptUrlInput.value.trim();
            if (!scriptUrl) {
                showAlert('Please provide your Google Apps Script endpoint URL at the top.', 'error');
                return;
            }

            const itemId = itemIdInput.value.trim();
            const location = storageLocationSelect.value;
            const operator = operatorNameInput.value.trim();

            if (!itemId || !location || !operator) {
                showAlert('Please complete all required fields.', 'error');
                return;
            }

            // Save operator name for convenience
            localStorage.setItem('inventory_operator_name', operator);

            // UI Loading state
            btnSubmit.disabled = true;
            btnSubmit.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> <span>Saving to Google Sheets...</span>`;

            try {
                // Post payload to Google Apps Script Web App
                const payload = {
                    itemId: itemId,
                    location: location,
                    operator: operator,
                    timestamp: new Date().toISOString()
                };

                await fetch(scriptUrl, {
                    method: 'POST',
                    mode: 'no-cors', // Standard cross-origin setting for Google Apps Script redirects
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                // With no-cors mode, we assume success if fetch resolves without throwing
                showAlert(`Record submitted successfully for item: <strong>${itemId}</strong>!`, 'success');
                
                // Clear scanned item input
                itemIdInput.value = '';
                toggleClearButton();

            } catch (err) {
                showAlert(`Submission failed: ${err.message}`, 'error');
            } finally {
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = `<i class="fa-solid fa-paper-plane"></i> <span>Submit to Google Sheet</span>`;
            }
        });

        // Display status feedback alerts
        function showAlert(msg, type = 'info') {
            statusAlert.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-800', 'border-emerald-200', 
                                         'bg-rose-50', 'text-rose-800', 'border-rose-200', 
                                         'bg-amber-50', 'text-amber-800', 'border-amber-200');

            if (type === 'success') {
                statusAlert.classList.add('bg-emerald-50', 'text-emerald-800', 'border-emerald-200');
                alertIcon.className = 'fa-solid fa-circle-check text-emerald-600 text-lg mt-0.5';
            } else if (type === 'error') {
                statusAlert.classList.add('bg-rose-50', 'text-rose-800', 'border-rose-200');
                alertIcon.className = 'fa-solid fa-circle-exclamation text-rose-600 text-lg mt-0.5';
            } else if (type === 'warning') {
                statusAlert.classList.add('bg-amber-50', 'text-amber-800', 'border-amber-200');
                alertIcon.className = 'fa-solid fa-triangle-exclamation text-amber-600 text-lg mt-0.5';
            }

            alertMessage.innerHTML = msg;
            statusAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        // Modal Handlers
        btnOpenGuide.addEventListener('click', () => guideModal.classList.remove('hidden'));
        btnCloseGuide.addEventListener('click', () => guideModal.classList.add('hidden'));
        btnDismissGuide.addEventListener('click', () => guideModal.classList.add('hidden'));
    </script>
</body>
</html>
